# Supabase — copiez ce fichier en .env.local et remplissez avec votre projet Supabase
# Dashboard Supabase : https://supabase.com/dashboard → votre projet → Settings → API
#
# Learn / Apprentissage : avec ces variables, la page fusionne le catalogue intégré et la table
# `learn_entries` (lecture publique). Les utilisateurs avec abonnement « super » actif peuvent
# publier ou modifier des fiches depuis /learn/admin (voir migrations Supabase + RLS).

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Arène — champions publics en base (page Avatars + Playoff)
# Requis : SUPABASE_SERVICE_ROLE_KEY. Propriétaire des bots « globaux » (Authentication → Users).
# Si vous êtes connecté à l’Arène, une copie publique est aussi créée sur VOTRE compte.
# FEATURED_PROFILE_SEED_USER_ID=your_auth_user_uuid_here

# PvP timeout sweep — POST/GET /api/pvp/cron/timeouts with Authorization: Bearer CRON_SECRET
# Vercel Hobby n'autorise qu'un cron/jour : utilisez cron-job.org, Supabase pg_cron, ou un cron Pro.
# Les timeouts live restent gérés côté client + GET /api/pvp/games/[id] pour les participants.
CRON_SECRET=your_random_cron_secret_here

# Stripe — Dashboard : https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Stripe Price IDs — Créez un produit "ChessAvatar Premium" dans Stripe Dashboard
STRIPE_PRICE_EUR=price_your_eur_price_id_here
STRIPE_PRICE_CHF=price_your_chf_price_id_here
STRIPE_PRICE_USD=price_your_usd_price_id_here

# Resend — Dashboard : https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Export ChessBase local — utilisé uniquement par scripts (ex. npm run pgn:count-games / pgn:split-chunks), pas par Next.js
# DATABASE2025_PGN_PATH=data/database2025/Database2025.pgn
# PGN_CHUNK_OUT_DIR=data/database2025/parts
# PGN_CHUNK_MAX_MB=85
# PGN_CHUNK_DELETE_SOURCE=1

# OpenAI — pour le Coach IA contextuel sur les key moments du Game Review
# Dashboard : https://platform.openai.com/api-keys
# Modèle utilisé : gpt-4o-mini (économique, ~$0.15/1M tokens d'entrée)
OPENAI_API_KEY=sk-your_openai_key_here

# Recommended in production — global API rate limits across Vercel instances (Upstash Redis REST).
# Without these, rate limits are per server instance only (weaker on Vercel).
# Create a database at https://console.upstash.com and paste REST URL + token
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Optional — shown in <html data-build> (defaults to VERCEL_GIT_COMMIT_SHA in production)
# NEXT_PUBLIC_BUILD_ID=local-dev

# Monitoring — see MONITORING.md (optional; app works without these)
# Sentry (https://sentry.io) — EU region recommended
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=chess-avatar
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_for_source_maps

# PostHog EU (https://eu.posthog.com)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
