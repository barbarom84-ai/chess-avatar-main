{
  "name": "chess-avatar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:opening-index": "node scripts/build-opening-fen-index.mjs",
    "openings:import-lichess": "node scripts/import-lichess-openings.mjs",
    "openings:refresh": "node scripts/import-lichess-openings.mjs && node scripts/build-opening-fen-index.mjs",
    "pgn:count-games": "node scripts/count-pgn-games.mjs",
    "pgn:split-chunks": "node scripts/split-pgn-chunks.mjs",
    "index-community-puzzles": "tsx scripts/index-community-puzzles.ts",
    "validate-campaign-puzzles": "tsx scripts/validate-campaign-puzzles.ts",
    "seed:featured-profiles": "tsx scripts/seed-featured-profiles.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "build:engine": "cd public && pyinstaller --onefile --noconsole --clean --distpath . --workpath ../.engine-build --specpath ../.engine-build --name AvatarEngine AvatarEngine.py",
    "sync:chessavatar": "node scripts/sync-chessavatar-wasm.mjs",
    "build:chessavatar": "node scripts/sync-chessavatar-wasm.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.560.0",
    "next": "^16.0.10",
    "openai": "^6.34.0",
    "posthog-js": "^1.374.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.5.1",
    "sonner": "^2.0.7",
    "stockfish.js": "^10.0.2",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.0.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.0.10",
    "supabase": "^2.101.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vercel": "^50.13.2",
    "vitest": "^4.1.5"
  }
}
