# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
_swaptest/

# next.js
/.next/
/out/

# production
/build

# PyInstaller artifacts (npm run build:engine)
.engine-build/
public/__pycache__/

# Local ChessBase / bulk PGN exports (often 500MB–2GB+; keep outside git)
data/database2025/*.pgn
data/database2025/*.pgi
data/database2025/parts/

scripts/fixtures/out-split-test/
scripts/fixtures/out-split-test2/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
